# ── Required (Railway) ──────────────────────────────────────────────
OPENAI_API_KEY=

# ── Access gate (recommended for Railway) ─────────────────────────
# When both are set, the entire app requires HTTP Basic Auth.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# ── OpenAI models ───────────────────────────────────────────────────
OPENAI_VISION_MODEL=gpt-5.6-terra
OPENAI_OBSERVER_MODEL=gpt-5.6-terra
OPENAI_REVIEWER_MODEL=gpt-5.6-sol
OPENAI_CRITIC_MODEL=gpt-5.6-sol

# ── OpenAI image detail ─────────────────────────────────────────────
# Allowed: low | high | original | auto
OPENAI_IMAGE_DETAIL=original
OPENAI_OVERVIEW_IMAGE_DETAIL=low
OPENAI_CROP_IMAGE_DETAIL=high

# ── OpenAI reasoning effort ─────────────────────────────────────────
# Allowed: none | low | medium | high | xhigh | max
OPENAI_REASONING_EFFORT=
OPENAI_OBSERVER_REASONING_EFFORT=high
OPENAI_REVIEWER_REASONING_EFFORT=medium
OPENAI_CRITIC_REASONING_EFFORT=medium
OPENAI_REWRITE_REASONING_EFFORT=medium

# ── Review timeouts (milliseconds) ────────────────────────────────────
QUICK_REVIEW_TIMEOUT_MS=180000
PRECISE_REVIEW_TIMEOUT_MS=240000
# Deprecated alias for precise timeout
SCREENSHOT_REVIEW_TIMEOUT_MS=

# ── Runtime (Railway sets automatically) ──────────────────────────────
# PORT=3000
# NODE_ENV=production

# ── Docker / Playwright (set in Dockerfile; do not change on Railway) ─
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
